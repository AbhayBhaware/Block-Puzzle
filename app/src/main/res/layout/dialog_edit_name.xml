<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="24dp"
    app:cardBackgroundColor="@color/card_bg"
    android:layout_margin="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDIT GAMER NAME"
            android:textColor="@color/accent_neon"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your name to appear on the leaderboard"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:fontFamily="sans-serif"/>

        <EditText
            android:id="@+id/editPlayerNameInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/card_surface_bg"
            android:paddingHorizontal="16dp"
            android:hint="Enter name (e.g. Rahul)"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:maxLength="20"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="end">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelName"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                android:background="?attr/selectableItemBackground"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveName"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Save"
                android:textColor="@color/white"
                android:background="@drawable/btn_gradient_classic"
                android:textAllCaps="false"
                android:paddingHorizontal="24dp"
                android:fontFamily="sans-serif-black"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
